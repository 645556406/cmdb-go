# 安全配置示例文件
# 复制为 .env.local 并填入实际值

# JWT密钥 - 生产环境请使用强密钥
VUE_APP_JWT_SECRET=your-super-secret-jwt-key-here

# SSH连接加密密钥 - 生产环境请使用强密钥
VUE_APP_SSH_ENCRYPTION_KEY=your-ssh-encryption-key-here

# API请求超时时间（毫秒）
VUE_APP_REQUEST_TIMEOUT=10000

# 是否启用HTTPS
VUE_APP_HTTPS=false

# 允许的域名列表（CORS配置）
VUE_APP_ALLOWED_ORIGINS=http://localhost:9529,http://127.0.0.1:9529

# 会话超时时间（分钟）
VUE_APP_SESSION_TIMEOUT=30